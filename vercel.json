{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1", "destination": "/api/v1" },
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" }
  ]
}
