# ===== Sufi Gateway API — Vercel Environment Variables =====
# Neon / Vercel Postgres connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Neon requires SSL. For a local Docker Postgres set this to "disable".
# DATABASE_SSL=disable

# 32+ random bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# 32+ random bytes. Generate: openssl rand -base64 48
# Used to encrypt provider API keys at rest (AES-256-GCM).
ENCRYPTION_KEY=change-me-to-a-long-random-string

# One-time code used by the app's first-run "Create admin" screen.
# After the first admin is created, remove this variable from Vercel.
SETUP_TOKEN=change-me-one-time-setup-code

# Public URL of this deployment (no trailing slash).
PUBLIC_BASE_URL=https://sufi-gateway-api.vercel.app

# Only for local testing with a mock provider on localhost. Keep false on Vercel.
ALLOW_LOCAL_PROVIDER=false
